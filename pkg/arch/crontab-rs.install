post_install() {
  cat <<'MSG'
==> crontab-rs replaces cronie as the system cron.
==> Enable the daemon with:  systemctl enable --now crond.service
==> cronie.service is an alias of crond.service, so an existing
==> cronie enablement keeps working.
==> There is no anacron. /etc/cron.d/0periodic runs cron.daily,
==> cron.weekly and cron.monthly at fixed times instead.
MSG
}

post_upgrade() {
  :
}
